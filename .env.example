# Copia este archivo a ".env" y rellena tus datos. Nunca subas ".env" al repo.

# --- Bridge MT5 (ver wine_bridge/server.py y scripts/start_mt5_bridge.sh) ---
# Las credenciales del terminal MT5 no van aqui: se pasan al bridge (que corre
# dentro de Wine) como argumentos --login/--password/--server, o se usa la sesion
# ya logueada en el terminal. Esto es solo la URL para hablar con ese bridge.
MT5_BRIDGE_URL=http://127.0.0.1:18812

# --- Ejecucion ---
TRADING_MODE=paper          # paper | live
RISK_PER_TRADE_PCT=1.0      # % del balance arriesgado por operacion
MAX_OPEN_POSITIONS=3

# --- Logging ---
LOG_LEVEL=INFO
