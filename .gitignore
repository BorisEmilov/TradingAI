# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Env / secrets
.env
*.env.local

# Salida de procesos lanzados en segundo plano (nohup, bridge MT5, reentrenos manuales)
nohup.out

# Data & modelos (pesados / generados)
data/raw/*
data/processed/*
data/models/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/models/.gitkeep

# Logs
logs/*
!logs/.gitkeep

# Notebooks checkpoints
.ipynb_checkpoints/

# OS / IDE
.DS_Store
.vscode/
.idea/

# Estado local de Claude Code (locks, checkpoints, mailbox de sesion) -- ya excluido
# via .git/info/exclude en este checkout, pero se agrega aqui tambien para que
# cualquier clon nuevo del repo lo ignore sin depender de config local por maquina.
.claude/
